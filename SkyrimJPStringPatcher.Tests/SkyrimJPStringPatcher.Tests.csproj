<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- v0.58.0: net9.0-windows (not net9.0) so this project can reference
         SkyrimJPStringPatcherGui.csproj (below). Harmless in practice, since
         this whole tool (WinForms GUI, MO2 paths) already only runs on Windows
         regardless of what this TFM declared before. -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SkyrimJPStringPatcher.csproj" />
    <!-- v0.58.0: CliLocator.cs is a plain static utility with no WinForms
         dependency (never instantiates a Form). This reference exists only
         so its file-layout detection logic (TryGetProductRoot/TryAutoDetect)
         is unit-testable, not to bring MainForm/SettingsForm etc. into scope. -->
    <ProjectReference Include="..\SkyrimJPStringPatcherGui\SkyrimJPStringPatcherGui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 固定のテスト用データファイル（golden files）。生成コードに頼らず、
         リポジトリにチェックインした状態で内容を直接確認・diffできるように
         する。テスト実行時に見えるよう出力フォルダへコピーする。 -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- v0.57.1: xUnitは既定でテストクラスを並列実行するが、多くのテストが
         PickUpTargetRunner.Run等の本番コード経由でプロセス全体を共有する
         Console.Out（静的リソース）へ素で書き込む。ConsoleCapture.cs（一部の
         テストが標準出力を検証用にキャプチャする仕組み）はそれ自身を経由する
         呼び出し同士は排他できるが、経由しない他の並列テストからの書き込み
         までは防げず、StringBuilderの非スレッドセーフな破損（
         ArgumentOutOfRangeException 'chunkLength'）が低頻度で発生していた。
         テストコレクションの並列実行そのものを無効化して解消する。 -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
