<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SkyrimJPStringPatcher.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 固定のテスト用データファイル（golden files）。生成コードに頼らず、
         リポジトリにチェックインした状態で内容を直接確認・diffできるように
         する。テスト実行時に見えるよう出力フォルダへコピーする。 -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- v0.57.1: xUnitは既定でテストクラスを並列実行するが、多くのテストが
         PickUpTargetRunner.Run等の本番コード経由でプロセス全体を共有する
         Console.Out（静的リソース）へ素で書き込む。ConsoleCapture.cs（一部の
         テストが標準出力を検証用にキャプチャする仕組み）はそれ自身を経由する
         呼び出し同士は排他できるが、経由しない他の並列テストからの書き込み
         までは防げず、StringBuilderの非スレッドセーフな破損（
         ArgumentOutOfRangeException 'chunkLength'）が低頻度で発生していた。
         テストコレクションの並列実行そのものを無効化して解消する。 -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
