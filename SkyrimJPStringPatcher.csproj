<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- v0.50.1a: SkyrimJPStringPatcherGui/ is a SIBLING project that happens to live
         inside this project's own directory tree (both under the same product-version
         folder). Without this, the default recursive **/*.cs glob pulls the GUI's
         WinForms-only source into this console project's compile and breaks the build. -->
    <Compile Remove="SkyrimJPStringPatcherGui\**\*.cs" />
    <!-- v0.55.0a: same reason, for the new SkyrimJPStringPatcher.Tests/ sibling project. -->
    <Compile Remove="SkyrimJPStringPatcher.Tests\**\*.cs" />
    <!-- 2026-09-11: same reason, for the new SJPTS_InterfaceText/ prototype sibling project
         (design/interface_translations.md) — it project-references THIS csproj to
         reuse Translation.ITextTranslator/Core.Mo2InstanceReader without copying them. -->
    <Compile Remove="SJPTS_InterfaceText\**\*.cs" />
    <!-- 2026-09-11: same reason, for the new SJPTS_InterfaceText.Tests/ sibling project. -->
    <Compile Remove="SJPTS_InterfaceText.Tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.54.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\transliteration_exclusions.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\skyrim_taiyaku_reference.tsv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\name_glossary.tsv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\color_words.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\corpus_exact_exclusions.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\phrase_overrides.tsv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Data\meaning_mining_exclusions.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
