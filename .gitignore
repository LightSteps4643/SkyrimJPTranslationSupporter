# ビルド成果物
bin/
obj/
*.csproj.user

# 各ステージの実行時派生物（実行のたびに作り直される）
PickUpTarget/out_temp/
PickUpTarget/excluded_candidates.txt
Translation/out_temp/
Translation/bak/
debug_out_temp/
out/

# SJPTS_InterfaceText（Interface\Translations翻訳、別CLI）側の同種の派生物。
# 上記のTranslation/out_temp・Translation/bak等はリポジトリルート直下にしか
# マッチしない（パターンの途中にスラッシュがあるため）ので、別途追加が必要。
InterfaceText/Translation/out_temp/
InterfaceText/Translation/bak/
# SJPTS_InterfaceText.exeを直接その場で実行したとき（--work=省略時）の既定の
# 作業フォルダ（AppContext.BaseDirectory相対）——CLIプロジェクト直下に作られる。
SJPTS_InterfaceText/out_temp/
SJPTS_InterfaceText/Translation/

# 開発中の調査用スクラッチファイル
tmp/
_backup/

# MOD単位の用語集（ファイル名がユーザーの導入MOD名そのものになるため、
# 個人の導入MODリストの流出を避ける目的で追跡しない。ツールが雛形を自動生成、
# 人が日本語列を埋める資産だが、公開リポジトリでは追跡しない方針とした）
Data/mod_glossary/*.tsv

# xTranslatorインポート用フォルダ（ユーザーが自分の翻訳ファイルを置く場所）
Translation/import/*
!Translation/import/.gitkeep

# SJPTS_InterfaceText側のインポートフォルダ（同じ理由）
InterfaceText/Translation/import/*
!InterfaceText/Translation/import/.gitkeep

# 実行ログ
*.log

# GUIのユーザー設定・APIキー（DPAPI暗号化されるが、そもそも個人環境依存のため追跡しない）
gui_settings.json

# 開発時の検討ログ（社内向け、リポジトリには含めない）
DESIGN_NOTES.md
DESIGN_HISTORY.md

# テストカバレッジ出力
CoverageResults/
